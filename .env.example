# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env
#
# ตัวแปรทุกตัวด้านล่างมีโค้ดอ่านจริง (ตรวจจาก process.env.* ใน app/ lib/ scripts/)

# ─── ฐานข้อมูล: SQL Server ───
# ใช้ร่วมกันทั้ง runtime (lib/mssql-config.ts, @prisma/adapter-mssql) และ Prisma CLI (prisma.config.ts)
MSSQL_SERVER="localhost"
MSSQL_PORT="1433"
MSSQL_DATABASE="requestonline"
MSSQL_USER="requestapp"
MSSQL_PASSWORD="CHANGE_ME"

# ปรับ connection pool / timeout เมื่อจูนประสิทธิภาพ (ค่าตั้งต้นเหมาะกับการใช้งานทั่วไป ไม่ต้องตั้งก็ได้)
# MSSQL_POOL_MAX="25"
# MSSQL_POOL_MIN="2"
# MSSQL_POOL_IDLE_MS="300000"
# MSSQL_POOL_ACQUIRE_MS="30000"
# MSSQL_CONNECTION_TIMEOUT_MS="15000"
# MSSQL_REQUEST_TIMEOUT_MS="30000"
# MSSQL_ENCRYPT="true"            # เฉพาะ Prisma CLI (prisma.config.ts); runtime เปิด encrypt เสมอ

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# URL สาธารณะของแอป (ใช้ทำลิงก์ในอีเมล /approve และ /request)
# บน production ตั้งเป็นที่อยู่ที่ผู้ใช้เปิดจริง ไม่เช่นนั้นลิงก์ในเมลจะชี้ผิดเครื่อง
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── อีเมล ───
# ลอง Internal Email API ก่อน ถ้าไม่ได้ตั้งหรือส่งไม่สำเร็จ จึงตกไปใช้ SMTP (ตั้งทั้งสองแบบได้ SMTP เป็นตัวสำรอง)
# (API URL อ่านจาก INTERNAL_EMAIL_API_URL → VITE_INTERNAL_EMAIL_API_URL → NEXT_PUBLIC_INTERNAL_EMAIL_API_URL ตามลำดับ)
# ถ้าไม่ตั้งทั้งสองแบบ หรือส่งไม่สำเร็จทั้งคู่ ระบบแค่บันทึก log แล้วทำงานต่อ: คำร้องและแจ้งเตือนในระบบยังถูกสร้างตามปกติ
# แต่ไม่มี retry และไม่มีใครถูกแจ้งว่าเมลไม่ออก (ข้อ outbox ใน docs/IMPROVEMENT-PLAN.md)
# Internal Email API (แนะนำ ลองก่อน)
INTERNAL_EMAIL_API_URL="https://your-mail-api.example.com/send"
# EMAIL_API_TIMEOUT_MS="8000"

# SMTP (Outlook / Office 365) — ตัวสำรองเมื่อ API ไม่ได้ตั้งหรือส่งไม่ผ่าน
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@company.com"
# SMTP_PASSWORD="app-password-or-secret"
# SMTP_FROM="your-email@company.com"

# ─── อื่น ๆ (ไม่บังคับ) ───
# ฟอนต์ไทยสำหรับ PDF ฝั่งเซิร์ฟเวอร์ (base64) — ดู docs/PDF-THAI.md ปกติไม่ต้องตั้ง
# NOTO_SANS_THAI_THIN_BASE64=""
# PRISMA_TRANSACTION_TIMEOUT_MS="20000"
# PRISMA_TRANSACTION_MAX_WAIT_MS="10000"
# HEALTH_DB_TIMEOUT_MS="5000"

# ─── ไฟล์แนบ ───
# ไฟล์ที่อัปโหลดเก็บที่โฟลเดอร์ ./uploads ใต้โฟลเดอร์ที่รันแอป (ตายตัวใน lib/storage.ts ไม่มีตัวแปรปรับ)
# ต้องสำรองโฟลเดอร์นี้พร้อมฐานข้อมูลเสมอ

# ─── ทดสอบ ───
# npm run test:e2e ตั้ง INTERNAL_EMAIL_API_URL ชี้ไป email sink ในเครื่องให้เอง ไม่ต้องตั้งที่นี่
# รายละเอียดดู docs/e2e-testing.md
